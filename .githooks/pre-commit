#!/bin/sh
# ROSI pre-commit gate. Enabled via `git config core.hooksPath .githooks`
# (run `node scripts/install-git-hooks.js` once; .npmrc sets ignore-scripts,
# so `npm install` does not run the prepare script that would do it).
# Bypass with: git commit --no-verify

set -e

run_npm() {
  # Call npm.cmd directly on Windows (not the POSIX npm shim) and avoid
  # cmd.exe re-parsing of arguments.
  if command -v npm.cmd >/dev/null 2>&1; then
    npm.cmd "$@"
  else
    npm "$@"
  fi
}

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"

# Only run JS tooling when staged files touch the frontend/tooling surface.
# .mjs and .cjs cover most of scripts/ and e2e/, so they are included.
if printf '%s\n' "$staged_files" | grep -qE '\.(ts|css|html|js|mjs|cjs)$'; then
  echo "pre-commit: prettier --check"
  run_npm run --silent format:check
  echo "pre-commit: eslint"
  run_npm run --silent lint
  echo "pre-commit: tsc --noEmit"
  run_npm run --silent typecheck
fi

# Rust formatting runs only when staged Rust sources exist.
if printf '%s\n' "$staged_files" | grep -qE '\.rs$'; then
  echo "pre-commit: cargo fmt --check"
  cargo fmt --manifest-path src-tauri/Cargo.toml -- --check
fi
