.DS_Store
# Logs
logs
*.log
npm-debug.log*

/coverage/*

licenses.json
**/.*/
!.github/
!.githooks/
!src-tauri/.cargo/
!src-tauri/.cargo/audit.toml

# Runtime data
pids
*.pid

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# dotenv environment variable files
.env
.env.*
!.env.example

# Vite logs
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tauri
src-tauri/target/
src-tauri/vendor/**/target/
src-tauri/binaries/
src-tauri/.cargo/*
!src-tauri/.cargo/audit.toml

# Build outputs
dist/
release/
flatpak-build/
flatpak-repo/
.flatpak-source/

# Generated files
public/licenses.json
public/licenses-cargo.json
public/licenses-cargo-unresolved.json
public/bundled-licenses.json
public/yt-dlp-notices.txt
public/ffmpeg-notice.txt
public/ffmpeg-license.txt
public/ffmpeg-source-offer.txt

# FFmpeg binaries (fetched with npm run get:ffmpeg, never committed)
resources/ffmpeg/**/ffmpeg
resources/ffmpeg/**/ffmpeg.exe
resources/ffmpeg/**/ffprobe
resources/ffmpeg/**/ffprobe.exe
resources/ffmpeg/**/ffplay
resources/ffmpeg/**/ffplay.exe

# yt-dlp binaries (fetched with npm run ytdlp:fetch, verified against
# assets/ytdlp-checksums.json and upstream GPG-signed SHA2-256SUMS, never committed)
assets/yt-dlp.exe
assets/yt-dlp_arm64.exe
assets/yt-dlp_macos
assets/yt-dlp_linux
assets/yt-dlp_linux_aarch64
assets/.ytdlp-download-*.tmp

# E2E run artifacts (kept locally as verification evidence)
e2e/artifacts/
