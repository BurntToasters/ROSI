{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROSI",
  "version": "5.0.0-beta.1",
  "identifier": "run.rosie.rosi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ROSI",
        "url": "index.html",
        "width": 1200,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; frame-src 'self'; worker-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["default", "splash"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "publisher": "BurntToasters",
    "copyright": "Copyright (c) BurntToasters",
    "category": "Utility",
    "shortDescription": "Cross-platform yt-dlp GUI",
    "longDescription": "ROSI is a fast, friendly graphical front end for yt-dlp with bundled FFmpeg, download queues, presets, and conversion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/rosi-yt-dlp", "binaries/rosi-ffmpeg", "binaries/rosi-ffprobe"],
    "resources": {
      "../assets/YT-DLP-NOTICES.txt": "yt-dlp/YT-DLP-NOTICES.txt",
      "../resources/ffmpeg/NOTICE.txt": "ffmpeg/NOTICE.txt",
      "../resources/ffmpeg/ffmpeg_license.txt": "ffmpeg/LICENSE.txt",
      "../resources/ffmpeg/SOURCE_OFFER.txt": "ffmpeg/SOURCE_OFFER.txt"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0",
      "bundleVersion": "5.0.3001",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 648,
          "height": 480
        },
        "appPosition": {
          "x": 120,
          "y": 300
        },
        "applicationFolderPosition": {
          "x": 546,
          "y": 300
        }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BurntToasters/ROSI/releases/latest/download/latest-{{target}}-{{arch}}.json",
        "https://github.com/BurntToasters/ROSI/releases/latest/download/latest-{{target}}.json",
        "https://github.com/BurntToasters/ROSI/releases/download/v{{current_version}}/latest-{{target}}-{{arch}}.json",
        "https://github.com/BurntToasters/ROSI/releases/download/v{{current_version}}/latest-{{target}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MzRDOTlCMDBEQjQ2REEKUldUYVJ0c0FtOGswZEpNTnNPZlBOZXhyNkJFT0F1L0hMWjlWcWxiZlA4R3hUTERPbTEvWXY0YWoK"
    }
  }
}
