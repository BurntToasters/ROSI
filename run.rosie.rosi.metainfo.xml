<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>run.rosie.rosi</id>
  <name>ROSI</name>
  <summary>Cross-platform GUI for yt-dlp</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <developer id="run.rosie">
    <name>BurntToasters</name>
  </developer>
  <description>
    <p>
      ROSI is a fast, friendly graphical front end for yt-dlp on Windows,
      macOS, and Linux, built with Tauri V2.
    </p>
    <p>Features:</p>
    <ul>
      <li>Download videos and audio from supported sites</li>
      <li>Download queue with retry, reordering, and per-item progress</li>
      <li>Saved download presets and playlist ranges</li>
      <li>Bundled FFmpeg for conversion to MP4, MOV, MP3, and M4A</li>
      <li>GPU-accelerated encoding (NVIDIA, AMD, Intel)</li>
      <li>Browser cookie integration</li>
      <li>Themed interface with light, dark, and purple themes</li>
    </ul>
  </description>
  <launchable type="desktop-id">run.rosie.rosi.desktop</launchable>
  <categories>
    <category>Utility</category>
    <category>AudioVideo</category>
    <category>Network</category>
  </categories>
  <url type="homepage">https://github.com/BurntToasters/ROSI</url>
